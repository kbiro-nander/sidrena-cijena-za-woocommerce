{
    "name": "nander/sidrena-cijena-za-woocommerce",
    "description": "Sidrena (dodatna) cijena, najniža cijena u 30 dana i strojno čitljiv cjenik za WooCommerce prema NN 101/2026 i Zakonu o zaštiti potrošača.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.7",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.12",
        "php-stubs/wordpress-stubs": "^6.6",
        "php-stubs/woocommerce-stubs": "^9.0",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SidrenaCijena\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SidrenaCijena\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpcs": "phpcs",
        "check": ["@test", "@phpstan"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
