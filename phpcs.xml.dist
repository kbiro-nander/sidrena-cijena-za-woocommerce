<?xml version="1.0"?>
<ruleset name="SidrenaCijena">
    <description>Coding standard for Sidrena cijena za WooCommerce.</description>
    <file>src</file>
    <file>sidrena-cijena-za-woocommerce.php</file>
    <file>uninstall.php</file>
    <file>templates</file>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <config name="testVersion" value="8.1-"/>
    <config name="minimum_wp_version" value="6.4"/>
    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>
        <exclude name="Universal.Operators.DisallowShortTernary"/>
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
        <exclude name="WordPress.PHP.YodaConditions"/>
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
        <exclude name="Squiz.PHP.DisallowSizeFunctionsInLoops"/>
        <exclude name="Generic.CodeAnalysis.AssignmentInCondition"/>
    </rule>
    <!-- Repositories call $this->wpdb->prepare(); the sniff cannot see through the property. -->
    <rule ref="WordPress.DB.PreparedSQL">
        <exclude-pattern>src/History/PriceHistoryRepository\.php</exclude-pattern>
        <exclude-pattern>src/History/Schema\.php</exclude-pattern>
        <exclude-pattern>src/Reference/MissingReferenceCounter\.php</exclude-pattern>
        <exclude-pattern>uninstall\.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders">
        <exclude-pattern>src/History/PriceHistoryRepository\.php</exclude-pattern>
        <exclude-pattern>src/Reference/MissingReferenceCounter\.php</exclude-pattern>
    </rule>
    <!-- Streaming writers and storage legitimately use native file functions on the uploads dir. -->
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>src/PriceList/*</exclude-pattern>
        <exclude-pattern>src/Endpoint/*</exclude-pattern>
        <exclude-pattern>src/Cli/*</exclude-pattern>
        <exclude-pattern>src/Admin/Tools/*</exclude-pattern>
        <exclude-pattern>uninstall\.php</exclude-pattern>
    </rule>
    <!-- Template variables are local to the including closure, not globals. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
        <exclude-pattern>templates/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array"><element value="manage_woocommerce"/></property>
        </properties>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array"><element value="sidrena-cijena-za-woocommerce"/></property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="scwc"/>
                <element value="SidrenaCijena"/>
                <element value="sidrena_cijena"/>
            </property>
        </properties>
    </rule>
</ruleset>
